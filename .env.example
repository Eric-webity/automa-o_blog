# Chaves de IA
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...

# Credenciais da UI (opcional — sem valores aceita e-mail + senha mín. 4 chars)
# Cada e-mail com registo em users tem histórico isolado (user_id nas matérias).
GEO_LOGIN_EMAIL=
GEO_LOGIN_PASSWORD=
# E-mail promovido a administrador na migração (opcional; usa GEO_LOGIN_EMAIL se vazio)
GEO_ADMIN_EMAIL=

# Sessão da interface (NiceGUI) — OBRIGATÓRIO em produção (GEO_ENV=production)
# Assina cookies de login (authenticated, email, user_id, role). Sem isto, qualquer
# pessoa com o segredo padrão de dev poderia forjar sessões.
# Gere um valor único (≥32 caracteres) e NUNCA commite no Git:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ver: docs/PRODUCAO_SESSOES.md
GEO_STORAGE_SECRET=

# Servidor
GEO_PORT=8080
GEO_ENV=development

# Cache de URLs de referência (horas; 0 = desativado)
GEO_URL_CACHE_TTL_HOURS=24

# Segurança de URLs (SSRF) — API e fetch
GEO_MAX_REFERENCE_URLS=20
GEO_MAX_URL_LENGTH=2048
GEO_URL_MAX_REDIRECTS=2

# Dono das matérias criadas via API REST (opcional; padrão: GEO_LOGIN_EMAIL ou 1.º utilizador)
GEO_API_OWNER_EMAIL=

# Fila em segundo plano (UI não trava em tarefas longas)
GEO_QUEUE_MIN_BLOG_WORDS=2600
GEO_QUEUE_MIN_TEXT_CHARS=12000
GEO_QUEUE_MIN_BATCH_ROWS=2

# Fetch headless para sites em JavaScript (auto | always | never)
# Requer: pip install playwright && playwright install chromium
GEO_BROWSER_FETCH=auto
GEO_BROWSER_TIMEOUT_MS=30000
GEO_BROWSER_WAIT_MS=2500
GEO_BROWSER_MIN_TEXT=200

# Alerta de similaridade matéria vs. fontes (0.0–1.0; padrão 0.85)
GEO_SIMILARITY_THRESHOLD=0.85

# Fila em segundo plano (UI não bloqueia)
GEO_QUEUE_MIN_BLOG_WORDS=2600
GEO_QUEUE_MIN_TEXT_CHARS=12000
GEO_QUEUE_MIN_BATCH_ROWS=2
GEO_QUEUE_MIN_URL_COUNT=3

# API REST (produção)
GEO_API_ENABLED=true
GEO_API_KEY=

# Webhook após geração (n8n, Zapier, Make)
GEO_WEBHOOK_URL=
GEO_WEBHOOK_SECRET=

# CMS externo (POST JSON genérico)
GEO_CMS_PUBLISH_URL=
GEO_CMS_PUBLISH_TOKEN=
GEO_CMS_DEFAULT_STATUS=draft
